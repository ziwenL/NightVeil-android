<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/scroll_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bg_app_gradient"
  android:clipToPadding="false"
  android:fillViewport="true">
  <LinearLayout
    android:id="@+id/content_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="10dp"
        android:background="@drawable/bg_chip_default"
        android:src="@drawable/ic_tile_veil"
        app:tint="@color/mask_primary"
        android:importantForAccessibility="no" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/brand_caption"
          android:textColor="@color/mask_primary"
          android:textSize="10sp"
          android:letterSpacing="0.2" />
        <TextView
          android:id="@+id/tv_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="@string/home_title"
          android:textColor="@color/mask_text_primary"
          android:textSize="26sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
    </LinearLayout>
    <TextView
      android:id="@+id/tv_subtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="18dp"
      android:text="@string/home_subtitle"
      android:textColor="@color/mask_text_secondary"
      android:textSize="14sp"
      android:lineSpacingExtra="3dp" />
    <LinearLayout
      android:id="@+id/card_main"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:background="@drawable/bg_surface_panel"
      android:orientation="vertical"
      android:padding="22dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
          android:id="@+id/tv_opacity_label"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/opacity_label"
          android:textColor="@color/mask_text_secondary"
          android:textSize="13sp" />
        <TextView
          android:id="@+id/tv_overlay_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_status_pill"
          android:text="@string/overlay_stopped"
          android:textColor="@color/mask_text_secondary"
          android:textSize="11sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/tv_opacity_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/preset_50"
        android:textColor="@color/mask_text_primary"
        android:textSize="64sp" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/intensity_hint"
        android:textColor="@color/mask_text_secondary"
        android:textSize="12sp" />
      <com.google.android.material.slider.Slider
        android:id="@+id/sb_transparency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:value="50"
        android:valueFrom="20"
        android:valueTo="90"
        android:stepSize="1"
        android:contentDescription="@string/slider_description"
        app:haloColor="@color/mask_primary"
        app:thumbColor="@color/mask_primary"
        app:thumbRadius="10dp"
        app:trackHeight="4dp"
        app:tickVisible="false"
        app:labelBehavior="gone"
        app:trackColorActive="@color/mask_primary"
        app:trackColorInactive="@color/mask_panel_border" />
      <include
        layout="@layout/slider_direction" />
      <LinearLayout
        android:id="@+id/layout_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/chip_preset_30"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_chip_default"
          android:foreground="?attr/selectableItemBackground"
          android:gravity="center"
          android:text="@string/preset_30"
          android:textColor="@color/mask_text_secondary"
          android:textSize="14sp"
          android:fontFamily="sans-serif-medium" />
        <TextView
          android:id="@+id/chip_preset_50"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_chip_default"
          android:foreground="?attr/selectableItemBackground"
          android:gravity="center"
          android:text="@string/preset_50"
          android:textColor="@color/mask_text_secondary"
          android:textSize="14sp"
          android:fontFamily="sans-serif-medium" />
        <TextView
          android:id="@+id/chip_preset_65"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_chip_default"
          android:foreground="?attr/selectableItemBackground"
          android:gravity="center"
          android:text="@string/preset_65"
          android:textColor="@color/mask_text_secondary"
          android:textSize="14sp"
          android:fontFamily="sans-serif-medium" />
        <TextView
          android:id="@+id/chip_preset_80"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:background="@drawable/bg_chip_default"
          android:foreground="?attr/selectableItemBackground"
          android:gravity="center"
          android:text="@string/preset_80"
          android:textColor="@color/mask_text_secondary"
          android:textSize="14sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
      <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="18dp"
        android:background="@color/mask_panel_border" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_timer"
        style="@style/Widget.NightVeil.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/timer_off"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:icon="@drawable/ic_clock"
        app:iconGravity="start" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_show"
        style="@style/Widget.NightVeil.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:text="@string/start_overlay"
        app:icon="@drawable/ic_power" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/card_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:orientation="vertical"
      android:paddingStart="4dp"
      android:paddingEnd="4dp">
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_tile"
        style="@style/Widget.NightVeil.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/tile_add"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:icon="@drawable/ic_tile_veil"
        app:iconGravity="start"
        app:backgroundTint="@color/mask_panel" />
      <TextView
        android:id="@+id/tv_permission_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/permission_missing"
        android:textColor="@color/mask_text_secondary"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/tv_notification_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/notification_ready"
        android:textColor="@color/mask_text_secondary"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/tv_last_used"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/last_used_label" />
      <TextView
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tips_text"
        android:textColor="@color/mask_text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp" />
    </LinearLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>